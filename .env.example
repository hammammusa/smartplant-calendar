# ------------------------------------------------------------------
# SmartPlant Calendar — environment variables
# Copy to .env.local and fill in. Never commit real values.
# ------------------------------------------------------------------

# Public site URL (used for SEO metadata, sitemap and auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API). Leave empty to run in preview mode:
# accounts are disabled and plans are stored only in the visitor's browser.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key. This key is public
# by design; data is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# No service-role key is required by the app. Do NOT add it here.

# Optional, server-only. Open-Meteo's free API is for non-commercial use.
# For commercial use, buy an API plan and set the key here.
OPEN_METEO_API_KEY=
