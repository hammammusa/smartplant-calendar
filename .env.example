# ------------------------------------------------------------------
# SmartPlant Calendar — build-time variables (static export)
# Copy to .env.local for local work. Every value here is embedded in the
# public JavaScript bundle: NEVER put a secret (e.g. service_role key) here.
# ------------------------------------------------------------------

# Sub-path the site is served from. Empty locally; "/smartplant-calendar" on
# https://hammammusa.github.io/smartplant-calendar/ (the deploy workflow sets it).
NEXT_PUBLIC_BASE_PATH=

# Public site URL including the sub-path (SEO, sitemap, auth email links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API). Leave empty for preview mode:
# accounts are disabled and plans are stored only in the visitor's browser.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key. Public by design;
# data is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
